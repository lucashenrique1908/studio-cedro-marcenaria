{
  "name": "studio-marcenaria",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional Studio Cedro Marcenaria",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode github-pages",
    "build:docs": "node scripts/copy-build.cjs dist docs",
    "preview": "vite preview",
    "verify": "node scripts/verify-build.cjs",
    "verify:pages": "node scripts/verify-build.cjs --pages",
    "verify:docs": "node scripts/verify-build.cjs --pages --dir docs",
    "deploy": "npm run build:pages && npm run verify:pages"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.5.14"
  }
}
